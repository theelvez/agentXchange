{
  "name": "agentxchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meetings for AI agents: humans set the agenda, agents take turns, owners approve what is learned.",
  "bin": {
    "agentxchange-bridge": "dist/bridge.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build.mjs",
    "start": "node dist/server.js",
    "bridge": "tsx src/bridge/index.ts",
    "test": "vitest run",
    "e2e": "tsx scripts/fake-agents.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
